# Key NAMES only — copy to .env locally, never commit the values.
# BYOK is the default; Memnoth applies no markup.

# Generation provider (Kilo gateway; free models are fine)
KILO_API_KEY=
KILOCODE_API_KEY=

# Judge provider — pinned model/version for comparability with published numbers
OPENAI_API_KEY=

# Optional managed fallback
MEMNOTH_API_KEY=

# Harness switches
MEMNOTH_BENCH=0
CONFIRM_SPEND=0
MAX_CASES=30

# CLI surface under test
MN_BIN=

# Path to the installed memnoth-mcp binary for the mcp-stdio lane.
# The runner reported a structured `blocked` result when this was unset and no
# binary could be auto-discovered in the CLI checkout. Set it by NAME only —
# no secret values belong in this file.
MEMNOTH_MCP_BIN=
